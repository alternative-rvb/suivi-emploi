{
  "name": "suivi-emploi",
  "version": "1.2.0",
  "private": true,
  "license": "MIT",
  "author": "alternative-rvb (https://www.alternative-rvb.com)",
  "homepage": "https://github.com/alternative-rvb/suivi-emploi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alternative-rvb/suivi-emploi.git"
  },
  "type": "module",
  "description": "Suivi local des offres France Travail et des candidatures",
  "scripts": {
    "start": "node --no-warnings server.mjs",
    "dev": "concurrently -k -n api,ui -c blue,magenta \"node --no-warnings --watch server.mjs\" \"vite\"",
    "build": "vite build",
    "sync": "node --no-warnings bin/sync.mjs",
    "demo": "node --no-warnings bin/demo.mjs",
    "analyse": "node --no-warnings bin/analyse.mjs",
    "rapport": "node --no-warnings bin/rapport.mjs",
    "cv": "node --no-warnings bin/cv.mjs",
    "test": "node --no-warnings --test \"tests/*.test.mjs\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p tests/tsconfig.json && tsc -p client/tsconfig.json"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
