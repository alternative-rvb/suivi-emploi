# Copier ce fichier vers .env (jamais versionné) puis renseigner les valeurs.
# Providers d'offres actifs, séparés par des virgules, dans l'ordre d'exécution (défaut : france-travail, n8n en secours)
# SUIVI_PROVIDERS=france-travail,n8n
# Au démarrage du serveur, la synchro est ignorée si la dernière réussie date de moins de N minutes (défaut 30, 0 pour toujours synchroniser).
# Utile en développement, où le serveur redémarre à chaque modification. Le bouton Actualiser force toujours.
# SUIVI_SYNC_MIN_MINUTES=30

# Zone « proche » (facultative) : code du département et villes proches séparées par des virgules, pour marquer les offres proches et les filtrer.
# Sans ces deux lignes, aucune offre n'est marquée proche.
# SUIVI_DEPARTEMENT_PROCHE=13
# SUIVI_VILLES_PROCHES=Marseille,Aix-en-Provence

# Distance des offres dans le score (facultatif). Points de départ « latitude,longitude » séparés par des points-virgules :
# la distance retenue est celle du point le plus proche. Sans cette ligne, le score garde la zone « proche » tout ou rien.
# SUIVI_ORIGINES=43.2965,5.3698;43.5297,5.4474
# Départements dont les communes sont chargées pour situer les offres (défaut : SUIVI_DEPARTEMENT_PROCHE).
# SUIVI_DEPARTEMENTS_DISTANCE=13,83
# Lieu bonus facultatif « latitude,longitude » : +3 points aux offres situées à 15 km ou moins.
# SUIVI_LIEU_BONUS=43.5297,5.4474

# Copie quotidienne de la base dans un dossier externe (facultatif), par exemple un dossier synchronisé avec un service de stockage en ligne.
# Le dossier doit exister. Une copie suivi-AAAA-MM-JJ.db par jour au démarrage du serveur, les 7 dernières sont gardées.
# La base elle-même (suivi.db) doit rester hors de ce dossier.
# SUIVI_EXPORT_DIR=/chemin/vers/le/dossier

# --- Provider n8n (secours) ---
# URL de production du webhook n8n (workflow "Suivi emploi API")
SUIVI_API_URL=https://votre-n8n.example.com/webhook/suivi-emploi/offres
# Jeton saisi dans le credential n8n "Suivi emploi API" (Header Auth)
SUIVI_API_TOKEN=
# Nom de l'en-tête du credential n8n (X-Api-Key par défaut)
# SUIVI_API_HEADER=X-Api-Key

# --- Provider france-travail (API directe, principal) ---
# Clés de l'application déclarée sur francetravail.io (jamais versionnées)
FT_CLIENT_ID=
FT_CLIENT_SECRET=
# Autres API de la même application francetravail.io (facultatives, mêmes clés FT_CLIENT_ID et FT_CLIENT_SECRET).
# Chaque API doit d'abord être ajoutée à l'application (Mes applications > Ajouter une API), puis son scope OAuth recopié ici
# tel qu'affiché sur francetravail.io. Sans scope, la fonctionnalité correspondante reste désactivée.
# La Bonne Boite v2 (entreprises à fort potentiel d'embauche, candidatures spontanées)
# FT_SCOPE_BONNEBOITE="api_labonneboitev2 search office"
# Marché du travail v1 (offres et demandeurs d'emploi par métier, carte Marché local de l'accueil ; département = SUIVI_DEPARTEMENT_PROCHE)
# FT_SCOPE_MARCHE="api_stats-offres-demandes-emploiv1 offresetdemandesemploi"

# --- Google Agenda (facultatif, carte Prochains rendez-vous) ---
# Client OAuth « Application de bureau » du projet Google Cloud (préparation décrite dans le README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# AGENDA_URL_TEST est réservée aux tests (redirige les appels Google vers un faux serveur) : ne pas la définir ici

# --- Analyse des annonces par un modèle de langage (facultatif, désactivée si ANALYSE_PROVIDER est vide) ---
# Fournisseur : ollama (modèle local) ou openai-compatible (LM Studio, llama.cpp, vLLM...)
# ANALYSE_PROVIDER=ollama
# Ollama : adresse (défaut http://localhost:11434) et modèle (défaut qwen3:8b, à télécharger avec « ollama pull qwen3:8b »)
# ANALYSE_URL=http://localhost:11434
# ANALYSE_MODELE=qwen3:8b
# Fenêtre de contexte en tokens (défaut 8192) et lancement automatique de « ollama serve » s'il est arrêté (0 pour l'interdire)
# ANALYSE_CONTEXTE=8192
# ANALYSE_OLLAMA_AUTO=1
# openai-compatible : ANALYSE_URL finit par /v1 (ex. http://localhost:1234/v1), ANALYSE_MODELE obligatoire, ANALYSE_CLE si le serveur en demande une
# ANALYSE_CLE=
# Une adresse hors de cette machine est refusée (le profil et les annonces partent dans chaque requête) sauf avec ANALYSE_DISTANT=1
# ANALYSE_DISTANT=0

ANALYSE_PROVIDER=ollama