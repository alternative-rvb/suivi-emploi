{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "useUnknownInCatchVariables": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["lib/**/*.mjs", "*.mjs", "bin/*.mjs", "lib/**/*.d.ts", "types.d.ts"],
  "exclude": ["node_modules", "dist", "client"]
}
